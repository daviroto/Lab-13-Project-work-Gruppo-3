# Riferimento per la configurazione tramite variabili d'ambiente.
# Questo file NON viene caricato automaticamente: impostare le variabili
# nella shell (PowerShell) prima di eseguire gli script.
#
# $env:LAB13_DATASET_PATH = "C:\percorso\dataset (1).csv"
# $env:LAB13_REQUESTS_PATH = "C:\percorso\richieste_monitoraggio.csv"

LAB13_DATASET_PATH=./dataset (1).csv
LAB13_REQUESTS_PATH=./richieste_monitoraggio.csv

# Tracciamento MLflow (fase S2): store locale, nessuna connessione esterna.
# Precedenza: --tracking-uri > LAB13_MLFLOW_TRACKING_URI > ./mlruns
LAB13_MLFLOW_TRACKING_URI=./mlruns
LAB13_MLFLOW_EXPERIMENT=lab13-progetto3-ritardi-consegne

# MLflow 3.x rifiuta lo store su file senza opt-out; src/lab13/tracking.py lo
# imposta, questa riga serve solo per sovrascriverlo esplicitamente.
MLFLOW_ALLOW_FILE_STORE=true
